enum Role {
  STUDENT
  STUDENT_SERVICE
  RTE
}

model Student {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  address     String
  contact     String
  parentEmail String
  image       String?
  role        Role      @default(STUDENT)
  facultyId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  faculty     Faculty?  @relation(fields: [facultyId], references: [id])
}

model StudentService {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(STUDENT_SERVICE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model RTE {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(RTE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model Faculty {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  students    Student[]
  modules     Module[]
}

model Module {
  id            String   @id @default(uuid())
  name          String
  code          String?
  moduleLeader  String
  facultyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  faculty       Faculty  @relation(fields: [facultyId], references: [id])
}

model FloorPlan {
  id        String   @id @default(uuid())
  name      String   @unique
  seats     Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Class {
  id          String   @id @default(uuid())
  name        String
  floorPlanId String
  assignments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}
