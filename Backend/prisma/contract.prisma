enum Role {
  STUDENT
  STUDENT_SERVICE
  RTE
}

model Student {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  address     String
  contact     String
  parentEmail String
  image       String?
  role        Role      @default(STUDENT)
  facultyId   String?
  semester    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  faculty     Faculty?     @relation(fields: [facultyId], references: [id])
  results     Result[]
  admitCards  AdmitCard[]
}

model StudentService {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(STUDENT_SERVICE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model RTE {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(RTE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model Teacher {
  id        String           @id @default(uuid())
  name      String
  email     String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime
  faculties TeacherFaculty[]
  modules   TeacherModule[]
}

model TeacherFaculty {
  id        String  @id @default(uuid())
  teacherId String
  facultyId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([teacherId, facultyId])
  @@index([facultyId])
  @@index([teacherId])
}

model TeacherModule {
  id        String  @id @default(uuid())
  teacherId String
  moduleId  String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([teacherId, moduleId])
  @@index([moduleId])
  @@index([teacherId])
}

model Faculty {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  students    Student[]
  modules     Module[]
  teachers    TeacherFaculty[]
}

model Module {
  id            String          @id @default(uuid())
  name          String
  code          String?
  moduleLeader  String
  facultyId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  faculty       Faculty         @relation(fields: [facultyId], references: [id])
  resultItems   ResultItem[]
  semesters     ModuleSemester[]
  teachers      TeacherModule[]
}

model ModuleSemester {
  id       String @id @default(uuid())
  moduleId String
  semester Int
  module   Module @relation(fields: [moduleId], references: [id])

  @@unique([moduleId, semester])
}

model Result {
  id        String       @id @default(uuid())
  studentId String
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime
  student   Student      @relation(fields: [studentId], references: [id])
  items     ResultItem[]
}

model ResultItem {
  id        String   @id @default(uuid())
  resultId  String
  moduleId  String
  score     Float
  grade     String
  createdAt DateTime @default(now())
  result    Result   @relation(fields: [resultId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])
}

model FloorPlan {
  id        String   @id @default(uuid())
  name      String   @unique
  seats     Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Class {
  id          String   @id @default(uuid())
  name        String
  floorPlanId String
  assignments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model ClassBooking {
  id        String   @id @default(uuid())
  classId   String
  bookedBy  String
  purpose   String
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([classId])
  @@index([isActive])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String
  studentId String?
  teacherId String?
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now())
}

model CalendarNote {
  id        String   @id @default(uuid())
  rteId     String
  date      DateTime
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model ExamRoutine {
  id          String       @id @default(uuid())
  rteId      String
  date       DateTime
  startTime  String
  endTime    String
  duration   String
  facultyId  String
  moduleId   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  admitCards AdmitCard[]
}

model AdmitCard {
  id            String   @id @default(uuid())
  studentId     String
  examRoutineId String
  seatNumber    String?
  roomName      String?
  pdfKey        String?
  generatedBy   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  student       Student     @relation(fields: [studentId], references: [id])
  examRoutine   ExamRoutine @relation(fields: [examRoutineId], references: [id])

  @@unique([studentId, examRoutineId])
}
