enum Role {
  STUDENT
  STUDENT_SERVICE
  RTE
}

model Student {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  address     String
  contact     String
  parentEmail String
  image       String?
  role        Role      @default(STUDENT)
  facultyId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  faculty     Faculty?  @relation(fields: [facultyId], references: [id])
  results     Result[]
}

model StudentService {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(STUDENT_SERVICE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model RTE {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(RTE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model Faculty {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  students    Student[]
  modules     Module[]
}

model Module {
  id            String   @id @default(uuid())
  name          String
  code          String?
  moduleLeader  String
  facultyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  faculty       Faculty  @relation(fields: [facultyId], references: [id])
  resultItems   ResultItem[]
}

model Result {
  id        String       @id @default(uuid())
  studentId String
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime
  student   Student      @relation(fields: [studentId], references: [id])
  items     ResultItem[]
}

model ResultItem {
  id        String   @id @default(uuid())
  resultId  String
  moduleId  String
  score     Float
  grade     String
  createdAt DateTime @default(now())
  result    Result   @relation(fields: [resultId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])
}

model FloorPlan {
  id        String   @id @default(uuid())
  name      String   @unique
  seats     Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Class {
  id          String   @id @default(uuid())
  name        String
  floorPlanId String
  assignments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String
  studentId String?
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now())
}

model CalendarNote {
  id        String   @id @default(uuid())
  rteId     String
  date      DateTime
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model ExamRoutine {
  id        String   @id @default(uuid())
  rteId     String
  date      DateTime
  startTime String
  endTime   String
  duration  String
  facultyId String
  moduleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}
